{
  "name": "@hangang-compass/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.16.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/architecture/*.test.ts test/integration/*.test.ts test/unit/domain/*.test.ts test/unit/infrastructure/*.test.ts",
    "test:postgres": "node --env-file=../.env --import tsx --test test/integration/postgres-meeting-repository.live.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.15.5",
    "tsx": "4.23.12"
  }
}
