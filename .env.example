# Required for Seoul Real-time City Data sample validation.
# Issue from: https://data.seoul.go.kr/together/mypage/actkeyMain.do
SEOUL_OPEN_DATA_KEY=

# Required for Kakao Map place search and public-transit route validation.
# Keep this server-side. Never expose it in the React browser bundle.
KAKAO_REST_API_KEY=

# Public browser key for the official KakaoTalk Share JavaScript SDK.
# Register the deployed web domain in Kakao Developers before enabling it.
VITE_KAKAO_JAVASCRIPT_KEY=

# Optional: used only for a small cross-provider validation sample.
TMAP_APP_KEY=
# Optional local SQLite path. Defaults to .data/meetings.sqlite.
MEETING_DATABASE_PATH=
# Production PostgreSQL connection string. Prefer Supabase Session pooler on IPv4 servers.
# Keep this server-side and never expose it to Vite.
DATABASE_URL=
