# Required for Seoul Real-time City Data sample validation.
# Issue from: https://data.seoul.go.kr/together/mypage/actkeyMain.do
SEOUL_OPEN_DATA_KEY=

# Required for Kakao Map place search and public-transit route validation.
# Keep this server-side. Never expose it in the React browser bundle.
KAKAO_REST_API_KEY=

# Optional: used only for a small cross-provider validation sample.
TMAP_APP_KEY=
