{
  "name": "hangang-compass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run security:check && npm run typecheck && npm test && npm run build",
    "dev:api": "npm run dev --workspace @hangang-compass/api",
    "dev:web": "npm run dev --workspace @hangang-compass/web",
    "security:check": "node scripts/check-repository-secrets.mjs",
    "test": "tsx --test domain/*.test.ts scripts/*.test.mjs && npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.domain.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
