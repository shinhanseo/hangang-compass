{
  "name": "hangang-compass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build --workspace @hangang-compass/backend && npm run build --workspace @hangang-compass/frontend",
    "check": "npm run security:check && npm run typecheck && npm test && npm run build",
    "dev:api": "npm run dev --workspace @hangang-compass/backend",
    "dev:web": "npm run dev --workspace @hangang-compass/frontend",
    "security:check": "node scripts/check-repository-secrets.mjs",
    "spike:seoul-crowd": "tsx scripts/inspect-seoul-crowd.ts",
    "test": "tsx --test scripts/*.test.mjs && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
